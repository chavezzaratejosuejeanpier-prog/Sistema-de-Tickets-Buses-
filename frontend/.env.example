# Copia como frontend/.env.local (ignorado por Git) solo si necesitas cambiar algo.
#
# IMPORTANTE: toda variable VITE_* se incrusta en el JavaScript público del
# navegador. Nunca pongas claves, contraseñas, tokens ni URLs de base de
# datos con prefijo VITE_: `npm run build` y `npm run dev` fallan si un
# nombre VITE_* parece un secreto.

# Base de la API. Por defecto /api en el mismo origen (FastAPI sirve el
# build y la API juntos; ver DESPLIEGUE_RENDER_NEON.md). Solo ruta
# absoluta del propio origen o URL https (http solo localhost en desarrollo).
VITE_API_URL=/api

# --- Solo desarrollo (sin prefijo VITE_: nunca llegan al bundle) ---
# Destino del proxy /api de `npm run dev` y `npm run preview`.
# DEV_API_PROXY=http://127.0.0.1:8000
# Host y puertos de los servidores locales de Vite.
# DEV_HOST=localhost
# DEV_PORT=5173
# PREVIEW_PORT=4173
