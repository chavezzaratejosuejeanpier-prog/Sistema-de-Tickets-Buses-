# URL de conexión a la base de datos.
# Por defecto usa SQLite (no requiere instalación adicional, ideal para desarrollo local).
DATABASE_URL=sqlite:///./buss_conectpro.db

# Para producción con PostgreSQL, usa este formato:
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/buss_conectpro

# Clave secreta usada para firmar los tokens JWT de autenticación.
# IMPORTANTE: cambia este valor por uno propio y nunca lo subas a git en el archivo .env real.
# Puedes generar una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=tu-clave-secreta-aqui

# Algoritmo usado para firmar los tokens JWT.
ALGORITHM=HS256

# Minutos de duración del token de acceso antes de expirar.
ACCESS_TOKEN_EXPIRE_MINUTES=60
