# Copia este archivo como backend/.env y completa los valores.
# Nunca subas backend/.env al repositorio (está en .gitignore).
# En Render/Neon NO uses archivo: define las variables en el panel del
# servicio (ver DESPLIEGUE_RENDER_NEON.md). Todo valor aquí es de ejemplo.

# ------------------------------------------------------------- entorno
# desarrollo | pruebas | produccion. En produccion la API no arranca si
# falta DATABASE_URL, si PostgreSQL remoto no usa TLS, si las docs están
# activas, si HOSTS_PERMITIDOS es "*" o si CORS_ORIGENES no es https.
ENTORNO=desarrollo

# ------------------------------------------------------- base de datos
# Desarrollo: omite la línea para usar backend/buss_conectpro.db o indica
# una URL SQLite válida (el seed de demostración exige esta variable).
# DATABASE_URL=sqlite:////ruta/absoluta/buss_conectpro.db
#
# Producción (Neon): URL privada con TLS. Se aceptan postgres:// y
# postgresql:// (se normalizan a postgresql+psycopg2://). Ejemplo ficticio:
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@ep-ejemplo.REGION.aws.neon.tech/buss?sslmode=verify-full&sslrootcert=system&channel_binding=require

# Pool por proceso (solo PostgreSQL).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# Segundos; Neon suspende el cómputo inactivo y cierra conexiones.
DB_POOL_RECYCLE=300
DB_CONNECT_TIMEOUT=10
# Milisegundos; 0 = sin límite. Déjalo en 0 con el host "-pooler" de Neon.
DB_STATEMENT_TIMEOUT_MS=0
# SQLite: modo WAL (cambia el archivo de forma persistente).
SQLITE_WAL=false
# SQLite en produccion solo para un piloto de una instancia con disco
# persistente (Render Free NO tiene disco persistente).
PERMITIR_SQLITE_PRODUCCION=false

# ---------------------------------------------------------------- JWT
# Obligatoria. Aleatoria, mínimo 32 caracteres y distinta por entorno.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# La API no arranca con un valor vacío, corto o de ejemplo.
SECRET_KEY=
# Solo HS256, HS384 o HS512.
ALGORITHM=HS256
# Entre 1 y 1440 minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----------------------------------------------------------------- API
# Swagger/ReDoc/OpenAPI. Vacío: activo en desarrollo, apagado en produccion
# (en produccion no se permite true).
# DOCS_ENABLED=
# Hosts válidos en la cabecera Host, separados por comas (sin esquema ni
# puerto; admite *.dominio). "*" solo fuera de produccion. En Render se
# añade automáticamente RENDER_EXTERNAL_HOSTNAME.
HOSTS_PERMITIDOS=*
# Orígenes CORS exactos separados por comas. Vacío = solo mismo origen
# (recomendado: la API sirve el frontend). En desarrollo también se acepta
# el servidor de Vite en http://localhost o http://127.0.0.1.
CORS_ORIGENES=

# ------------------------------------------------------------ servidor
# Usados por `python servidor.py`. En Render: HOST=0.0.0.0 (PORT lo inyecta
# la plataforma).
HOST=127.0.0.1
PORT=8000
# Un proceso: el limitador de intentos está en memoria por proceso.
WEB_CONCURRENCY=1
TIMEOUT_KEEP_ALIVE=5
# Proxy inverso confiable. Vacío = se ignoran X-Forwarded-For/Proto.
# En producción se rechaza "*". Deja la lista vacía hasta verificar las IP
# o redes CIDR acotadas del proxy de entrada con el proveedor. Configura
# solo esas direcciones, separadas por comas. La IP del cliente es la
# entrada número PROXY_SALTOS contando desde la derecha de X-Forwarded-For.
PROXY_IPS_CONFIABLES=
PROXY_SALTOS=1

# ---------------------------------------------------------- frontend
# true: la API sirve frontend/dist (npm run build) en el mismo origen que
# /api, con fallback de la SPA, caché y cabeceras (CSP con hashes).
SERVIR_FRONTEND=false
# Ruta del build; por defecto ../frontend/dist respecto de backend/.
# FRONTEND_DIST=/ruta/absoluta/frontend/dist

# ------------------------------------------------------------- tareas
# Inserta al arrancar las salidas de demostración que falten (sin DDL ni
# cambios de horarios/precios existentes).
PROGRAMA_DEMO_AL_ARRANCAR=true

# ------------------------------------------------------------ registro
# DEBUG | INFO | WARNING | ERROR. Formato json (producción) o texto.
LOG_LEVEL=INFO
LOG_FORMAT=json

# Administrador inicial: NO se configura en este archivo. Usa
#   python bootstrap_admin.py --email correo@dominio   (pide la contraseña sin eco)
# o exporta BUSS_ADMIN_EMAIL y BUSS_ADMIN_PASSWORD solo en la sesión de la
# terminal. Ver backend/INICIALIZACION_SEGURA.md.
#
# Esquema: la API no crea tablas al arrancar. Ejecuta `python migrar.py`
# antes del primer arranque y tras cada actualización.
#
# Datos de demostración (solo desarrollo): python seed.py --desarrollo
# exige DATABASE_URL explícita de tipo SQLite en archivo; no usa la ruta por defecto.
