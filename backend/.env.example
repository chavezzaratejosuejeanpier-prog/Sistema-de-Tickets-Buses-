# Copia este archivo como backend/.env y completa los valores.
# Nunca subas backend/.env al repositorio (está en .gitignore).

# Desarrollo: omite la línea para que la API use backend/buss_conectpro.db
# (el seed de demostración, en cambio, exige esta variable explícita) o indica
# una URL SQLite válida. Producción: URL privada de PostgreSQL con TLS.
# DATABASE_URL=sqlite:////ruta/absoluta/buss_conectpro.db

# Obligatoria. Aleatoria, mínimo 32 caracteres y distinta por entorno.
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# La API no arranca con un valor vacío, corto o de ejemplo.
SECRET_KEY=

# Solo HS256, HS384 o HS512.
ALGORITHM=HS256
# Entre 1 y 1440 minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Swagger/ReDoc/OpenAPI. En producción: false.
DOCS_ENABLED=true

# Administrador inicial: NO se configura en este archivo. Usa
#   python bootstrap_admin.py --email correo@dominio   (pide la contraseña sin eco)
# o exporta BUSS_ADMIN_EMAIL y BUSS_ADMIN_PASSWORD solo en la sesión de la
# terminal. Ver backend/INICIALIZACION_SEGURA.md.
#
# Datos de demostración (solo desarrollo): python seed.py --desarrollo
# exige DATABASE_URL explícita de tipo SQLite en archivo; no usa la ruta por defecto.
